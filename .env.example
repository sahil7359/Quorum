# Quorum — example environment. Copy to .env and fill in.
# .env is gitignored. Never commit real values.

# --- LLM provider -----------------------------------------------------------
# One of: groq | ollama
# Provider is a config change only; no code changes between local eval and prod.
QUORUM_LLM_PROVIDER=ollama

# Groq (production / demo). Free tier: 30 RPM, 1000 req/day, 100K tokens/day.
QUORUM_GROQ_API_KEY=
QUORUM_GROQ_BASE_URL=https://api.groq.com/openai/v1
QUORUM_GROQ_SPECIALIST_MODEL=llama-3.1-8b-instant
QUORUM_GROQ_SYNTHESIS_MODEL=llama-3.3-70b-versatile

# Ollama (local evaluation only — never run eval against Groq).
QUORUM_OLLAMA_BASE_URL=http://localhost:11434
QUORUM_OLLAMA_SPECIALIST_MODEL=llama3.1:8b
QUORUM_OLLAMA_SYNTHESIS_MODEL=qwen3-coder:30b

# --- Cost controls ----------------------------------------------------------
QUORUM_DAILY_TOKEN_BUDGET=100000
QUORUM_MAX_DIFF_LINES=1500
QUORUM_LIVE_REVIEWS_PER_DAY=4

# --- GitHub -----------------------------------------------------------------
# Scoped PAT: public_repo only for the write path. Never a classic full-scope token.
QUORUM_GITHUB_TOKEN=
QUORUM_GITHUB_MCP_COMMAND=docker
QUORUM_GITHUB_MCP_ARGS=run,-i,--rm,-e,GITHUB_PERSONAL_ACCESS_TOKEN,ghcr.io/github/github-mcp-server

# --- Persistence ------------------------------------------------------------
# Neon in production; local Docker Postgres for integration tests.
QUORUM_DATABASE_URL=postgresql://quorum:quorum@localhost:5433/quorum

# --- Retrieval --------------------------------------------------------------
QUORUM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QUORUM_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
QUORUM_RETRIEVAL_TOP_K=5
QUORUM_RETRIEVAL_CANDIDATES=30
QUORUM_RERANK_ENABLED=false   # measured: reranking lost on our corpus. See docs/adr/0004.

# --- Observability ----------------------------------------------------------
QUORUM_LOG_LEVEL=INFO
QUORUM_LOG_FORMAT=json

# --- GitHub App (the write path) --------------------------------------------
# Posting review comments runs as a GitHub App, not the PAT above: scoped to only the
# installed repos and only the granted permissions, with a token that expires in ~1 hour.
# Leave empty to disable writes entirely (the read path works on the PAT alone).
# The .pem is gitignored under secrets/ and never committed.
QUORUM_GITHUB_APP_ID=
QUORUM_GITHUB_APP_INSTALLATION_ID=
QUORUM_GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
